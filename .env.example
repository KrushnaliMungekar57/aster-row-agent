# Copy this file to .env and fill in real values. Never commit .env.

# Required: your free Groq API key (no credit card needed).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (defaults shown).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Paths are resolved relative to the repo root by default; override only if
# you need to point at a different knowledge base, orders file, or log file.
# KB_DIR=./knowledge-base
# ORDERS_PATH=./data/orders.json
# LOG_PATH=./logs/trace.jsonl

# Retrieval / agent loop tuning.
# RETRIEVAL_TOP_K=4
# MAX_TOOL_ITERATIONS=4
# MAX_HISTORY_TURNS=12
